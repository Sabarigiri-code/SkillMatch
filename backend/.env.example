# SkillMatch AI Backend Environment Variables

# MongoDB Connection String
# Local:  mongodb://localhost:27017/skillmatch
# Atlas:  mongodb+srv://<username>:<password>@cluster.mongodb.net/skillmatch
MONGODB_URI=mongodb://localhost:27017/skillmatch

# JWT Secret (min 256-bit / 32 characters for HS256)
# Generate a strong value: openssl rand -hex 32
JWT_SECRET=replace-with-a-strong-random-secret-never-commit-real-value

# JWT Expiration in milliseconds (86400000 = 24 hours)
JWT_EXPIRATION=86400000

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173
